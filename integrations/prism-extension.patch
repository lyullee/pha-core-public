@@ -0,0 +1,104 @@
+"""FTA/LOPA derived frequencies, separate from literature catalogues.
+
+This contract preserves arithmetic and input/run identities. It does not certify
+an independence assessment or fabricate a provider release. Existing consequence
+binding validates the physical release, duration, opening, service and ports.
+"""
+from __future__ import annotations
+
+import math
+from typing import Annotated, Literal
+
+from pydantic import Field, model_validator
+
+from .contracts import Contract, Fraction, Name, Nonnegative
+from .frequency import ReleaseDefinition
+
+Hash = Annotated[str, Field(pattern=r"^[a-f0-9]{64}$")]
+
+
+class ProbabilityCredit(Contract):
+    factor_id: Name
+    kind: Literal['barrier_failure', 'conditional_transition']
+    probability: Fraction
+    owner: Name
+    source_id: Name
+
+
+class DerivedFrequencyEvent(Contract):
+    id: Name
+    asset_id: Name
+    model_component_id: Name
+    port_ids: tuple[Name, ...]
+    basis: Literal['FTA_LOPA_DERIVED'] = 'FTA_LOPA_DERIVED'
+    profile: Literal['DERIVED_PROVIDER'] = 'DERIVED_PROVIDER'
+    statistic: Literal['computed_model'] = 'computed_model'
+    endpoint: Literal['loss_of_containment']
+    baseline_digest: Hash
+    analysis_digest: Hash
+    analysis_code_digest: Hash
+    prism_source_digest: Hash
+    analysis_run_id: Name
+    scenario_id: Name
+    operating_case_id: Name
+    source: Name
+    source_sha256: Hash
+    base_frequency_per_year: Nonnegative
+    annual_frequency_per_year: Nonnegative
+    credits: tuple[ProbabilityCredit, ...]
+    upstream_included_barrier_ids: tuple[Name, ...] = ()
+    upstream_included_transition_ids: tuple[Name, ...] = ()
+    included_barrier_ids: tuple[Name, ...]
+    included_transition_ids: tuple[Name, ...]
+    # One reviewed provider outlet allocation; item/length aggregation is not
+    # silently assigned to a single release point.
+    exposure_multiplier: Literal[1.0] = 1.0
+    location_weight: None = None
+    release: ReleaseDefinition
+    evidence_status: Literal['SYNTHETIC', 'REVIEWED_INPUTS']
+    operating_mode: Name
+    hazop_scenario_id: Name
+    limitations: tuple[str, ...]
+    physical_validation_claim: Literal[False] = False
+    complete_facility_qra_claim: Literal[False] = False
+
+    @model_validator(mode='after')
+    def arithmetic_and_identity(self):
+        expected_ports = 2 if self.release.mode == 'two_sided_rupture' else 1
+        if len(self.port_ids) != expected_ports or len(set(self.port_ids)) != len(self.port_ids):
+            raise ValueError('derived frequency requires exact unique provider outlet identities')
+        if self.release.mode in {'hole', 'two_sided_rupture'} and self.release.hole_diameter_m is None:
+            raise ValueError('derived hole/rupture requires a provider-owned failure opening')
+        if self.source_sha256 != self.baseline_digest:
+            raise ValueError('derived source must identify the immutable baseline')
+        keys = [(c.kind, c.factor_id) for c in self.credits]
+        if any(c.owner != self.scenario_id for c in self.credits):
+            raise ValueError('probability credits must identify this scenario as their application owner')
+        if len(keys) != len(set(keys)):
+            raise ValueError('duplicate probability credit')
+        barrier = tuple(c.factor_id for c in self.credits if c.kind == 'barrier_failure')
+        transitions = tuple(c.factor_id for c in self.credits if c.kind == 'conditional_transition')
+        if set(barrier) & set(self.upstream_included_barrier_ids) or set(transitions) & set(self.upstream_included_transition_ids):
+            raise ValueError('probability credit already included upstream')
+        for actual, expected in ((self.included_barrier_ids, self.upstream_included_barrier_ids + barrier),
+                                 (self.included_transition_ids, self.upstream_included_transition_ids + transitions)):
+            if len(actual) != len(set(actual)) or set(actual) != set(expected):
+                raise ValueError('included factor ledger disagrees with applied probability credits')
+        computed = self.base_frequency_per_year * math.prod(c.probability for c in self.credits)
+        if not math.isclose(computed, self.annual_frequency_per_year, rel_tol=1e-12, abs_tol=0):
+            raise ValueError('derived frequency does not match base rate and credited probabilities')
+        return self
+
+
+def bind_derived_event(request, event: DerivedFrequencyEvent):
+    """Use the existing physical binder; preserve a distinct derived event type."""
+    from .frequency import bind_event
+    if not isinstance(event, DerivedFrequencyEvent):
+        raise TypeError('DerivedFrequencyEvent required')
+    if request.frequency_event is not None or request.annual_frequency_per_year is not None or request.annual_frequency_provenance is not None:
+        raise ValueError('derived binding requires an unbound physical template')
+    if request.resolved_release is None and request.resolved_release_set is None and request.resolved_liquid_release is None:
+        raise ValueError('derived frequency requires a provider-resolved physical accident boundary')
+    if request.operating_mode != event.operating_mode or request.hazop_scenario_id != event.hazop_scenario_id:
+        raise ValueError('derived event operating mode/HAZOP scenario must match the physical template')
+    return bind_event(request, event)
diff --git a/lh2-tno/src/lh2_tno/derived_campaign.py b/lh2-tno/src/lh2_tno/derived_campaign.py
new file mode 100644
