+++ b/lh2-tno/src/lh2_tno/derived_campaign.py
@@ -0,0 +1,87 @@
+"""Execute selected derived events with auditable, explicitly partial risk sums.
+
+Literature FrequencyPlan qualification and full-facility promotion stay separate.
+Only executed physical cases enter this diagnostic contribution ledger.
+"""
+import json
+import math
+
+from pydantic import model_validator
+
+from .campaign import _checked_harm
+from .contracts import Contract, Fraction, Name, Nonnegative, canonical_digest
+from .consequences import ConsequenceRequest
+from .derived_frequency import DerivedFrequencyEvent, bind_derived_event
+
+
+class DerivedCase(Contract):
+    id: Name
+    event: DerivedFrequencyEvent
+    annual_condition_id: Name
+    annual_condition_probability: Fraction
+    request: ConsequenceRequest
+    # Population is explicit; omission must not imply zero people.
+    persons_by_receptor: dict[Name, Nonnegative]
+
+    @model_validator(mode='after')
+    def unbound(self):
+        bind_derived_event(self.request, self.event)
+        return self
+
+
+def evaluate_derived_campaign(pipeline, cases, *, expected_source_digest):
+    cases = tuple(DerivedCase.model_validate_json(json.dumps(c, allow_nan=False)) for c in cases)
+    if not cases or len(cases) > 100 or len({c.id for c in cases}) != len(cases):
+        raise ValueError('campaign requires 1..100 unique cases')
+    pairs = [(c.event.id, c.annual_condition_id) for c in cases]
+    if len(set(pairs)) != len(pairs):
+        raise ValueError('duplicate event/annual condition would double count frequency')
+    events = {}
+    scenario_events = {}
+    for c in cases:
+        e = c.event
+        if e.prism_source_digest != expected_source_digest:
+            raise ValueError('derived campaign PRISM source digest changed')
+        if e.id in events and events[e.id] != e:
+            raise ValueError('same event id has inconsistent frequency/provenance')
+        events[e.id] = e
+        prior = scenario_events.setdefault((e.scenario_id, e.baseline_digest), e.id)
+        if prior != e.id:
+            raise ValueError('multiple events for one scenario require an explicit disjoint partition')
+    if len({e.baseline_digest for e in events.values()}) != 1:
+        raise ValueError('cannot aggregate alternative baselines as simultaneous events')
+    for e in events.values():
+        weight = sum(c.annual_condition_probability for c in cases if c.event.id == e.id)
+        if not math.isclose(weight, 1., rel_tol=0, abs_tol=1e-12):
+            raise ValueError('annual-condition probabilities must close to one for every selected event')
+    if len({c.request.radiative_fraction_range for c in cases}) != 1:
+        raise ValueError('radiation sensitivity endpoints must be shared across cases')
+    receptors = [r.id for r in pipeline.facility.receptors]
+    atoms, executed = [], []
+    for c in cases:
+        if set(c.persons_by_receptor) != set(receptors):
+            raise ValueError('explicit population required for every facility receptor')
+        request = bind_derived_event(c.request, c.event)
+        result = pipeline.consequences(request)
+        if result.get('frequency_event') != c.event.model_dump(mode='json'):
+            raise ValueError('derived event identity lost during consequence execution')
+        probabilities = request.ignition.probabilities()
+        harms = _checked_harm(result['data'], receptors, probabilities)
+        executed.append({'case_id': c.id, 'event_id': c.event.id, 'annual_condition_id': c.annual_condition_id,
+                         'annual_condition_probability': c.annual_condition_probability,
+                         'event_digest': c.event.digest(), 'request_digest': request.digest(),
+                         'result_digest': canonical_digest(result), 'result': result})
+        for branch, probability in probabilities.items():
+            weight = c.annual_condition_probability * probability * request.occupancy_probability
+            atoms.append({'event_id': c.event.id, 'annual_condition_id': c.annual_condition_id,
+                          'ignition_branch': branch, 'conditional_weight': weight,
+                          'initiating_frequency_per_year': c.event.annual_frequency_per_year,
+                          'receptor_harm_low_high': {rid: [harms[rid][i][branch] for i in range(2)] for rid in receptors},
+                          'expected_deaths_low_high': [sum(c.persons_by_receptor[rid] * harms[rid][i][branch] for rid in receptors) for i in range(2)]})
+    aggregate = pipeline.backend.run('facility_risk_aggregate', {'receptor_ids': receptors, 'atoms': atoms})
+    return {'schema_version': 'prism.derived_contribution.v1', 'status': 'DIAGNOSTIC_SELECTED_EVENT_CONTRIBUTION',
+            'facility_digest': pipeline.facility.digest(), 'events': [e.model_dump(mode='json') for e in events.values()],
+            'cases': executed, 'atoms': atoms, 'known_contribution': aggregate,
+            'physical_validation_claim': False, 'complete_facility_qra_claim': False,
+            'limitations': ['Selected derived final-outcome events only; successful protection discharge hazards and other LOCs may be missing.',
+                            'Full-facility evidence gates and literature campaign qualification are not promoted by this diagnostic sum.']}
diff --git a/lh2-tno/tests/test_derived_frequency.py b/lh2-tno/tests/test_derived_frequency.py
new file mode 100644
--- /dev/null
+++ b/lh2-tno/tests/test_derived_frequency.py
@@ -0,0 +1,55 @@
+"""Derived contracts must remain separate from published catalogue events."""
+import json
+from pathlib import Path
+
+import pytest
+
+from lh2_tno.consequences import ConsequenceRequest
+from lh2_tno.derived_frequency import DerivedFrequencyEvent, bind_derived_event
+from lh2_tno.frequency import FrequencyEvent
+
+
+def event_data():
+    return dict(id='derived:test', asset_id='AST-TANK', model_component_id='storage', port_ids=['storage.out'],
+                endpoint='loss_of_containment', baseline_digest='a'*64, analysis_digest='b'*64,
+                analysis_code_digest='c'*64, prism_source_digest='d'*64, analysis_run_id='run-1',
+                scenario_id='SC-1', operating_case_id='OP-1', source='synthetic FTA/LOPA test', source_sha256='a'*64,
+                base_frequency_per_year=.1, annual_frequency_per_year=.0002,
+                credits=[dict(factor_id='IPL-1',kind='barrier_failure',probability=.01,owner='SC-1',source_id='FTA-1'),
+                         dict(factor_id='TR-1',kind='conditional_transition',probability=.2,owner='SC-1',source_id='DAT-1')],
+                included_barrier_ids=['IPL-1'], included_transition_ids=['TR-1'],
+                release={'mode':'hole','hole_diameter_m':.01}, evidence_status='SYNTHETIC',
+                operating_mode='receiving',hazop_scenario_id='SC-1',limitations=['synthetic contract regression'])
+
+
+def test_derived_is_not_literature_event():
+    raw = event_data()
+    event = DerivedFrequencyEvent.model_validate_json(json.dumps(raw))
+    assert event.basis == 'FTA_LOPA_DERIVED'
+    with pytest.raises(ValueError):
+        FrequencyEvent.model_validate_json(event.model_dump_json())
+
+
+@pytest.mark.parametrize('mutation,match', [
+    (lambda d:d.update(annual_frequency_per_year=.01),'credited probabilities'),
+    (lambda d:d['credits'].append(d['credits'][0].copy()),'duplicate probability'),
+    (lambda d:d.update(upstream_included_barrier_ids=['IPL-1']),'already included'),
+    (lambda d:d.update(included_barrier_ids=[]),'factor ledger'),
+    (lambda d:d.update(port_ids=[]),'provider outlet'),
+    (lambda d:d.update(source_sha256='0'*64),'immutable baseline'),
+])
+def test_derived_contract_rejects_ambiguous_values(mutation,match):
+    raw=event_data()
+    mutation(raw)
+    with pytest.raises(ValueError,match=match):
+        DerivedFrequencyEvent.model_validate_json(json.dumps(raw))
+
+
+def test_derived_event_requires_provider_resolved_accident():
+    raw=json.loads((Path(__file__).parents[1]/'examples/consequence_request.json').read_text(encoding='utf-8'))
+    raw.update(annual_frequency_per_year=None,annual_frequency_provenance=None,initiation_intensity_per_s=None,
+               operating_mode='receiving',hazop_scenario_id='SC-1')
+    request=ConsequenceRequest.model_validate_json(json.dumps(raw))
+    event=DerivedFrequencyEvent.model_validate_json(json.dumps(event_data()))
+    with pytest.raises(ValueError,match='provider-resolved'):
+        bind_derived_event(request,event)
